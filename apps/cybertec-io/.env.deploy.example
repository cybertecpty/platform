# Copy to `.env.deploy` (gitignored) for a local `nx deploy cybertec-io`. Nx loads it
# for the deploy target only. CI sets this variable from the `cybertec-io` environment
# secret instead.
#
# Get the token from the Azure portal: Static Web App > Manage deployment token, or run
#   az staticwebapp secrets list --name <swa-name> --resource-group <rg> --query properties.apiKey -o tsv
SWA_CLI_DEPLOYMENT_TOKEN=
