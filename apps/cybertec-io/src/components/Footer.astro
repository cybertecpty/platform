---
const year = new Date().getFullYear();
---

<footer class="bg-blueprint border-t border-[rgb(var(--paper-rgb)/0.2)]">
  <div class="site-container flex flex-wrap items-center justify-between gap-4 py-10">
    <div class="flex items-center gap-3">
      <img src="/brand/cybertec-mark-white.svg" alt="" width="34" height="34" loading="lazy" />
      <div>
        <p class="font-display text-[21px] font-medium text-paper">CyberTec</p>
        <p class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-[rgb(var(--paper-rgb)/0.7)]">
          Code, crafted with care
        </p>
      </div>
    </div>
    <p class="font-mono text-xs text-[rgb(var(--paper-rgb)/0.7)]">© {year} CyberTec LLC</p>
  </div>
</footer>
