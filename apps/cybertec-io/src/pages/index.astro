---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Stack from '../components/Stack.astro';
import Principles from '../components/Principles.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import WorkingWithMe from '../components/WorkingWithMe.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  {/*
    The sticky <header> is its own banner landmark, outside <main>; the page
    sections live inside <main> so assistive tech has a single primary landmark.
  */}
  <Header />
  <main>
    <Hero />
    <Services />
    <Stack />
    <Principles />
    <Experience />
    <About />
    <WorkingWithMe />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
