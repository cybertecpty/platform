---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import frauncesNormal from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CyberTec',
  description = 'Personal site of Daniel McGrath, a senior software engineer working mostly with Angular, .NET and Nx monorepos.'
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;

const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel McGrath',
  jobTitle: 'Senior Software Engineer',
  description: 'Senior software engineer working mostly with Angular, .NET and Nx monorepos.',
  url: 'https://cybertec.io',
  email: 'contact@cybertec.io',
  knowsAbout: ['Angular', 'TypeScript', '.NET', 'Nx'],
  sameAs: ['https://github.com/cybertecpty', 'https://linkedin.com/in/djmcgrath101']
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#14110d" />

    {/* Preload the headline font to avoid a swap-induced layout shift. */}
    <link rel="preload" href={frauncesNormal} as="font" type="font/woff2" crossorigin />

    {/* Open Graph / Twitter, with the 1200×630 brand social card. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CyberTec" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CyberTec — Code, crafted with care." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Brand favicon: ink mark on a copper field. SVG for modern browsers, with
        a multi-resolution .ico fallback (16/32/48) for those without SVG icon
        support. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)}></script>
    {/* Brand fonts are self-hosted via @fontsource (imported above) — no
        third-party font request. */}
  </head>
  <body class="flex min-h-dvh flex-col">
    {/*
      Plain shell — no global content container. The page applies
      `.site-container` (1180px / 28px gutters) to its own inner wrapper so
      the full-bleed blueprint grid can span the viewport while content stays centered.
    */}
    <slot />
  </body>
</html>
