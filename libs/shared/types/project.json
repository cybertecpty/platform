{
  "name": "shared-types",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/types/src",
  "projectType": "library",
  "tags": ["domain:shared", "scope:shared", "type:types"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/types",
        "main": "libs/shared/types/src/index.ts",
        "tsConfig": "libs/shared/types/tsconfig.lib.json",
        "assets": ["libs/shared/types/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/shared/types/tsconfig.spec.json"
      }
    }
  }
}
