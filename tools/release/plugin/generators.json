{
  "generators": {
    "package-version": {
      "factory": "./src/lib/generators/package-version/generator",
      "schema": "./src/lib/generators/package-version/schema.json",
      "description": "Set the version field of an existing package.json to an explicit semantic version or a release-type bump."
    },
    "release": {
      "factory": "./src/lib/generators/release/generator",
      "schema": "./src/lib/generators/release/schema.json",
      "description": "release generator"
    },
    "release-manifest": {
      "factory": "./src/lib/generators/release-manifest/generator",
      "schema": "./src/lib/generators/release-manifest/schema.json",
      "description": "Write a `release-manifest.json` at a project's root."
    }
  }
}
