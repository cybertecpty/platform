  createBaseVitestConfig(import.meta.dirname),
  defineConfig({
    plugins: [angular()],
    test: {
      name: '<%= name %>',
      environment: 'jsdom',
      setupFiles: ['src/test-setup.ts'],
      coverage: { exclude: ['src/test-setup.ts'] }
    }
  })
);
