import { logger, type Tree } from '@nx/devkit';
import { createTreeWithEmptyWorkspace } from '@nx/devkit/testing';
import { vi } from 'vitest';
import { <%= generatorFnName %> } from './generator';
import type { <%= className %>GeneratorOptions } from './schema';

describe('<%= generatorFnName %>', () => {
  let tree: Tree;
  const options: <%= className %>GeneratorOptions = { name: 'test' };

  beforeEach(() => {
    tree = createTreeWithEmptyWorkspace();
    vi.spyOn(logger, 'info').mockImplementation(() => undefined);
  });

  it('runs without throwing', async () => {
    await expect(<%= generatorFnName %>(tree, options)).resolves.toBeUndefined();
  });
});
