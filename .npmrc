# pnpm configuration. See https://pnpm.io/npmrc
# Nx manages the pnpm version declared in package.json's "packageManager" field.
manage-package-manager-versions=true
# Install peer dependencies automatically.
auto-install-peers=true
# Start lenient on peer mismatches; tighten to true once the tree is clean.
strict-peer-dependencies=false
# Strict, isolated node_modules (pnpm default). Fix hoisting-dependent tools with
# targeted public-hoist-pattern[] entries, not by switching to node-linker=hoisted
# (see docs/adr/0001-replace-npm-with-pnpm.md).
node-linker=isolated
