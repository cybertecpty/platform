{
  "name": "@cybertecpty/platform",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "affected:format": "pnpm exec nx format:write --affected",
    "format": "pnpm exec nx format:write --all",
    "format:check": "pnpm exec nx format:check --all",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "nx"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,cts,mts,js,jsx,cjs,mjs}": [
      "eslint --fix --no-warn-ignored",
      "nx format:write --files"
    ],
    "*.{json,md,mdx,html,css,scss,yml,yaml}": [
      "nx format:write --files"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
