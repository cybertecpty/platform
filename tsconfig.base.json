{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@cybertecpty/angular-core": ["./libs/shared/angular/core/src/index.ts"],
      "@cybertecpty/angular-plugin": ["./tools/angular/plugin/src/index.ts"],
      "@cybertecpty/angular-testing": ["./libs/shared/angular/testing/src/index.ts"],
      "@cybertecpty/angular-utils": ["./libs/shared/angular/utils/src/index.ts"],
      "@cybertecpty/azure-plugin": ["./tools/azure/plugin/src/index.ts"],
      "@cybertecpty/dotnet-plugin": ["./tools/dotnet/plugin/src/index.ts"],
      "@cybertecpty/fs-utils": ["./libs/shared/fs/utils/src/index.ts"],
      "@cybertecpty/git-testing": ["./tools/git/testing/src/index.ts"],
      "@cybertecpty/git-utils": ["./tools/git/utils/src/index.ts"],
      "@cybertecpty/github-utils": ["./tools/github/utils/src/index.ts"],
      "@cybertecpty/js-plugin": ["./tools/js/plugin/src/index.ts"],
      "@cybertecpty/logging-testing": ["./libs/shared/logging/testing/src/index.ts"],
      "@cybertecpty/logging-utils": ["./libs/shared/logging/utils/src/index.ts"],
      "@cybertecpty/ngrx-core": ["./libs/shared/ngrx/core/src/index.ts"],
      "@cybertecpty/ngrx-plugin": ["./tools/ngrx/plugin/src/index.ts"],
      "@cybertecpty/ngrx-utils": ["./libs/shared/ngrx/utils/src/index.ts"],
      "@cybertecpty/node-plugin": ["./tools/node/plugin/src/index.ts"],
      "@cybertecpty/nx-plugin": ["./tools/nx/plugin/src/index.ts"],
      "@cybertecpty/nx-testing": ["./tools/nx/testing/src/index.ts"],
      "@cybertecpty/nx-types": ["./tools/nx/types/src/index.ts"],
      "@cybertecpty/nx-utils": ["./tools/nx/utils/src/index.ts"],
      "@cybertecpty/playwright-testing": ["./libs/shared/playwright/testing/src/index.ts"],
      "@cybertecpty/release-plugin": ["./tools/release/plugin/src/index.ts"],
      "@cybertecpty/types": ["./libs/shared/types/src/index.ts"],
      "@cybertecpty/utils": ["./libs/shared/utils/src/index.ts"],
      "@cybertecpty/vitest-testing": ["./libs/shared/vitest/testing/src/index.ts"]
    },
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "importHelpers": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "exclude": ["node_modules", "tmp"]
}
